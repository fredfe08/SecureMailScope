{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "module", "input", "tooling", "capture_quality", "protocol_detection", "tcp_streams", "starttls", "tls", "certificates"],
  "properties": {
    "schema_version": {"type": "string"},
    "module": {"const": "M1-PCAP-Network-Evidence-Extraction"},
    "input": {"type": "object", "required": ["path"]},
    "tooling": {"type": "object", "required": ["tshark_version", "verified_fields"]},
    "capture_quality": {"type": "object"},
    "protocol_detection": {"type": "object", "required": ["packet_counts", "observed_protocols"]},
    "tcp_streams": {"type": "array"},
    "starttls": {"type": "array"},
    "tls": {"type": "object", "required": ["status", "handshake_stages", "handshake_complete"]},
    "certificates": {"type": "array"}
  },
  "additionalProperties": true
}
